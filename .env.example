# Machine Learning Backend Configuration
# URL of the Python Flask backend for sentiment analysis
# Only needed if running ML backend separately
ML_BACKEND_URL=http://localhost:5000

# AI Provider Configuration (Optional - for sentiment analysis)
# Not used in current implementation (using TF-IDF + Naive Bayes instead)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini

# Sylor AI API Configuration
# Used for AI-powered recommendations based on sentiment analysis
# Provider: Sylor API (https://api.sylorapi.com)
# API Format: OpenAI-style chat/completions (v1/chat/completions)
# Add these to Netlify Environment Variables (not in .env file)
OPENAI_API_KEY=<your_sylor_api_key>
OPENAI_MODEL=gpt-5.6-luna
OPENAI_BASE_URL=https://api.sylorapi.com/v1
OPENAI_CHAT_ENDPOINT=/chat/completions

# Allowed models for Sylor API:
# - gpt-5.6-luna (default, lighter)
# - gpt-5.6-terra
